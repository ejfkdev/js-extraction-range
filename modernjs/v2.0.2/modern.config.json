{
  "_raw": {
    "runtime": {
      "router": true
    },
    "plugins": [
      {
        "name": "@modern-js/app-tools",
        "post": [
          "@modern-js/plugin-initialize",
          "@modern-js/plugin-analyze",
          "@modern-js/plugin-ssr",
          "@modern-js/plugin-document",
          "@modern-js/plugin-state",
          "@modern-js/plugin-router",
          "@modern-js/plugin-router-v5",
          "@modern-js/plugin-polyfill"
        ],
        "registerHook": {
          "modifyEntryExport": {},
          "modifyEntryImports": {},
          "modifyEntryRuntimePlugins": {},
          "modifyEntryRenderFunction": {},
          "modifyAsyncEntry": {},
          "modifyFileSystemRoutes": {},
          "modifyServerRoutes": {},
          "htmlPartials": {},
          "beforeGenerateRoutes": {},
          "addDefineTypes": {},
          "collectServerPlugins": {},
          "beforeDev": {},
          "afterDev": {},
          "beforeCreateCompiler": {},
          "afterCreateCompiler": {},
          "beforePrintInstructions": {},
          "beforeBuild": {},
          "afterBuild": {},
          "beforeDeploy": {},
          "afterDeploy": {},
          "watchFiles": {},
          "fileChange": {},
          "beforeRestart": {},
          "registerDev": {},
          "beforeDevTask": {},
          "registerBuildPlatform": {},
          "beforeBuildPlatform": {}
        },
        "usePlugins": [
          {
            "name": "@modern-js/plugin-initialize"
          },
          {
            "name": "@modern-js/plugin-analyze"
          },
          {
            "name": "@modern-js/plugin-lint"
          }
        ]
      }
    ]
  },
  "source": {
    "alias": {
      "styled-components": "node_modules/styled-components/dist/styled-components.cjs.js",
      "@modern-js/runtime/plugins": "node_modules/.modern-js/.runtime-exports/plugins.js",
      "@_modern_js_internal": "node_modules/.modern-js",
      "@_modern_js_src": "src",
      "@": "src",
      "@shared": "shared"
    },
    "globalVars": {
      "process.env.IS_REACT18": "true"
    },
    "preEntry": [],
    "compileJsDataURI": true,
    "define": {},
    "enableAsyncEntry": false,
    "disableDefaultEntries": false,
    "entriesDir": "./src",
    "configDir": "./config",
    "include": [
      "node_modules/.modern-js"
    ]
  },
  "server": {
    "baseUrl": "/",
    "port": 8080
  },
  "bff": {},
  "dev": {
    "hmr": true,
    "https": false,
    "port": 8080,
    "assetPrefix": "/",
    "startUrl": false,
    "progressBar": true
  },
  "html": {
    "inject": "head",
    "mountId": "root",
    "crossorigin": false,
    "disableHtmlFolder": false,
    "title": "",
    "meta": {
      "charset": {
        "charset": "utf-8"
      },
      "viewport": "width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no",
      "http-equiv": {
        "http-equiv": "x-ua-compatible",
        "content": "ie=edge"
      },
      "renderer": "webkit",
      "layoutmode": "standard",
      "imagemode": "force",
      "wap-font-scale": "no",
      "format-detection": "telephone=no"
    }
  },
  "output": {
    "distPath": {
      "root": "dist",
      "js": "static/js",
      "css": "static/css",
      "svg": "static/svg",
      "font": "static/font",
      "html": "html",
      "image": "static/image",
      "media": "static/media",
      "server": "bundles"
    },
    "filename": {},
    "charset": "ascii",
    "polyfill": "entry",
    "dataUriLimit": {
      "svg": 10000,
      "font": 10000,
      "image": 10000,
      "media": 10000
    },
    "legalComments": "linked",
    "cleanDistPath": true,
    "svgDefaultExport": "url",
    "disableCssExtract": false,
    "disableMinimize": false,
    "disableSourceMap": {
      "js": false
    },
    "disableTsChecker": false,
    "disableFilenameHash": false,
    "disableCssModuleExtension": false,
    "disableInlineRuntimeChunk": false,
    "enableAssetFallback": false,
    "enableAssetManifest": false,
    "enableLatestDecorators": false,
    "enableCssModuleTSDeclaration": false,
    "enableInlineScripts": false,
    "enableInlineStyles": false,
    "disableNodePolyfill": true
  },
  "security": {},
  "tools": {
    "cssExtract": {
      "loaderOptions": {},
      "pluginOptions": {}
    },
    "tsChecker": {
      "issue": {
        "include": [
          {
            "file": "**/src/**/*"
          }
        ],
        "exclude": [
          {
            "file": "**/*.(spec|test).ts"
          },
          {
            "file": "**/node_modules/**/*"
          }
        ]
      }
    },
    "htmlPlugin": [
      null,
      null
    ]
  },
  "testing": {},
  "plugins": [
    "[Circular 0]"
  ],
  "builderPlugins": [],
  "runtime": {
    "router": true
  },
  "runtimeByEntries": {},
  "deploy": {},
  "performance": {},
  "experiments": {},
  "autoLoadPlugins": false
}
