
const map = {
    './x.js': () => import('src/widgets/x.js'),
'./x': () => import('src/widgets/x.js'),
'./y.js': () => import('src/widgets/y.js'),
'./y': () => import('src/widgets/y.js')
};

module.exports = (id) => {
    if (map[id]) return map[id]();
    else {
        const e = new Error("Cannot find module '" + id + "'");
        e.code = 'MODULE_NOT_FOUND';
        throw e;
    }
};
