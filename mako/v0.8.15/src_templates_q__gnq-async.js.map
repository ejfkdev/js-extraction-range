
const map = {
    './a.js': () => import('src/templates/a.js'),
'./a': () => import('src/templates/a.js'),
'./b.js': () => import('src/templates/b.js'),
'./b': () => import('src/templates/b.js'),
'./c.js': () => import('src/templates/c.js'),
'./c': () => import('src/templates/c.js')
};

module.exports = (id) => {
    if (map[id]) return map[id]();
    else {
        const e = new Error("Cannot find module '" + id + "'");
        e.code = 'MODULE_NOT_FOUND';
        throw e;
    }
};
